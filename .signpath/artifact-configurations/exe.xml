<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath, slug "exe": zenith-player.exe dla instalatora NSIS (już z typem NSS) i portable -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Zenith" product-version="${version}">
      <include path="zenith-player.exe" />
      <include path="Zenith_*_portable.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
