FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential pkg-config file unzip \
    libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev \
    patchelf libudev-dev libgtk-3-dev libayatana-appindicator3-dev \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && corepack enable \
  && corepack prepare pnpm@9 --activate \
  && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

WORKDIR /src
COPY scripts/linux-build-inner.sh /usr/local/bin/zenith-linux-build
RUN chmod +x /usr/local/bin/zenith-linux-build

ENTRYPOINT ["/usr/local/bin/zenith-linux-build"]
