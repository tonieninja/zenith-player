# Arch: WebKitGTK z upstreamu bez łatki Debiana na NVIDII i układ katalogów, którego oczekuje quick-sharun
FROM archlinux:base-devel

RUN pacman -Syu --noconfirm --needed \
    git curl wget file patchelf cmake xorg-server-xvfb xorg-xauth dbus ttf-dejavu \
    rustup nodejs npm \
    webkit2gtk-4.1 gtk3 libayatana-appindicator librsvg openssl systemd-libs alsa-lib \
    gstreamer gst-plugins-base gst-plugins-good gst-libav pipewire-alsa alsa-plugins \
  && rustup default stable \
  && npm install -g pnpm@10.18.3 \
  && rm -rf /var/cache/pacman/pkg/*

WORKDIR /src
COPY scripts/linux-build-inner.sh /usr/local/bin/zenith-linux-build
RUN chmod +x /usr/local/bin/zenith-linux-build

ENTRYPOINT ["/usr/local/bin/zenith-linux-build"]
